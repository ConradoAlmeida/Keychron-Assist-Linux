#!/bin/sh
set -e

if [ "$1" = configure ]; then
  if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --action=add --subsystem-match=input --settle || true
    udevadm trigger --action=add --subsystem-match=hidraw --settle || true
  fi
fi

#DEBHELPER#

exit 0
