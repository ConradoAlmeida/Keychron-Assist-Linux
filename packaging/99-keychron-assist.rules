# Let the active session's user read input events from Keychron devices
# (needed for quick start / Launch APP) and write to their hidraw nodes
# (needed by the site's WebHID to program the key).
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{idVendor}=="3434", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", TAG+="uaccess"
